root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = intellij_idea

# A compat package takes the id of its mod (CD-OPT-05), and some ids hold underscores, such as compat/forbidden_arcanus/.
[**/cobblemondynamics/compat/**.kt]
ktlint_standard_package-name = disabled
